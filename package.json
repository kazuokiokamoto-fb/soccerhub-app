{
  "name": "soccerhub-app",
  "version": "0.1.0",
  "private": true,
  "workspaces": ["apps/selection"],
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "node --experimental-strip-types --disable-warning=MODULE_TYPELESS_PACKAGE_JSON --test lib/selection-frontend/*.test.ts lib/auth-session/*.test.ts",
    "selection:typecheck": "npm run typecheck -w soccerhub-selection",
    "selection:lint": "npm run lint -w soccerhub-selection",
    "selection:build": "npm run build -w soccerhub-selection",
    "selection:deploy": "npx supabase functions deploy selection-crawler",
    "selection:run": "curl -X POST 'https://senspqsexmtrwjfsdadv.supabase.co/functions/v1/selection-crawler' -H \"Authorization: Bearer $SELECTION_SECRET\" -H \"apikey: $SELECTION_SECRET\" -H \"x-selection-secret: $SELECTION_SECRET\""
  },
  "dependencies": {
    "@supabase/ssr": "^0.8.0",
    "@supabase/supabase-js": "^2.93.3",
    "next": "16.1.4",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.1.4",
    "tailwindcss": "^4",
    "typescript": "^5"
  }
}