{
  "name": "サカまっち",
  "short_name": "サカまっち",
  "description": "練習試合マッチングです。相手を探して、募集して、チャットで調整できます。",
  "start_url": "/",
  "scope": "/",
  "display": "standalone",
  "background_color": "#ffffff",
  "theme_color": "#145c2a",
  "orientation": "portrait",
  "icons": [
    {
      "src": "/icon-192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/icon-512.png",
      "sizes": "512x512",
      "type": "image/png"
    },
    {
      "src": "/icon-512-maskable.png",
      "sizes": "512x512",
      "type": "image/png",
      "purpose": "maskable"
    }
  ],

  "display_override": ["standalone", "minimal-ui"],

  "prefer_related_applications": false
}